{
  "name": "@flowscripter/io-plugin-filesystem",
  "version": "1.0.6",
  "description": "Local filesystem source/sink plugin for https://github.com/flowscripter/pluggable-io-framework",
  "keywords": [
    "bun",
    "dynamic",
    "framework",
    "io",
    "pluggable-io-framework",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/io-plugin-filesystem#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/io-plugin-filesystem.git"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "dist/bundle.js",
  "exports": {
    ".": {
      "default": "./dist/bundle.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir ./dist --entry-naming bundle.js --target bun --minify --external \"@flowscripter/dynamic-plugin-framework\"",
    "test": "bun test"
  },
  "dependencies": {
    "@flowscripter/pluggable-io-framework-api": "^1.0.9",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@flowscripter/dynamic-plugin-framework": "^2.2.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0"
  },
  "peerDependencies": {
    "@flowscripter/dynamic-plugin-framework": "*",
    "typescript": "^7.0.2"
  },
  "pluggable-io-framework": {
    "extensionPoints": [
      "@flowscripter/pluggable-io-framework/provider-factory"
    ]
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
